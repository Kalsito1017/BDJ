{
  "name": "bdz-train-companion",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cross-platform (iOS + Android) React Native + TypeScript train companion app for Bulgarian State Railways (BDZ) passengers. Journey planning and trip information only; no live data, no in-app ticket sales (feature flag OFF, mock provider only).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci",
    "audit:deps": "node scripts/audit-gate.mjs",
    "audit:raw": "npm audit --audit-level=high"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@hookform/resolvers": "^5.9.2",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "^58.0.17",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "node-forge": "1.4.3"
  }
}
