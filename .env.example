# BDZ Train Companion — environment variables
# ---------------------------------------------------------------
# Safe placeholders ONLY. Never put real secrets in this file or in
# EXPO_PUBLIC_* variables: EXPO_PUBLIC_* values are PUBLIC — they are
# compiled into the client bundle (addbeforerelease.txt §5).
# Real values go into .env (git-ignored) or CI secret storage.
# ---------------------------------------------------------------

# Which environment the app thinks it is running in: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the train-data API.
# EMPTY ON PURPOSE: no live train data source is approved yet (DEC-002,
# mock-only). Do not point this at any BDZ or third-party endpoint without
# written authorization recorded in docs/decisions.md.
EXPO_PUBLIC_TRAIN_API_BASE_URL=

# Map SDK key. This is a PUBLIC identifier, not a secret: restrict it by
# bundle identifier / package name at the provider instead (plan.md 17.5).
# No key exists today: the selected stack is MapLibre RN + OpenFreeMap, which
# is keyless (DEC-012). Kept empty for any future keyed provider.
EXPO_PUBLIC_MAP_SDK_KEY=
